{
  "name": "@tcxp/tcxp",
  "version": "0.2.0",
  "description": "Typed Context Protocol (tcxp) v0.2 reference engine: one-line addresses that parse into expression trees, carry their own context, and run",
  "keywords": ["tcxp", "typed-context-protocol", "uri", "query", "sql", "expression-tree", "decision-state", "provenance"],
  "author": "Ron Itelman",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "main": "tcxp.js",
  "files": ["tcxp.js", "README.md", "SPEC.md", "LICENSE", "fixtures/"],
  "homepage": "https://github.com/typed-context-protocol/tcxp-simulator-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typed-context-protocol/tcxp-simulator-web.git"
  },
  "bugs": {
    "url": "https://github.com/typed-context-protocol/tcxp-simulator-web/issues"
  },
  "scripts": {
    "build": "python3 src/build_core.py && python3 src/build.py",
    "verify": "node test/verify.mjs",
    "fuzz": "node test/fuzz.mjs 2000 7",
    "fuzz:writes": "node test/fuzz.mjs 1000 11 --writes",
    "compat": "node test/compat.mjs",
    "vectors": "node python/tools/export_vectors.mjs",
    "gate:js": "npm run build && node test/verify.mjs && npm run build && node test/fuzz.mjs 2000 7 && node test/fuzz.mjs 1000 11 --writes && node test/compat.mjs && node test/api.mjs && node test/context.mjs && node test/formats.mjs",
    "gate": "npm run gate:js && lean lean/Tcxp.lean",
    "api": "node test/api.mjs",
    "context": "node test/context.mjs",
    "formats": "node test/formats.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
